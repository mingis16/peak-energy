# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the deployed app; used for sign-up confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Timezone the station's "today" is based on.
NEXT_PUBLIC_STATION_TIMEZONE=Africa/Freetown

# Optional, server only: lets the owner add staff accounts with a login and
# password (Settings → Staff & access). Supabase → Project Settings → API →
# service_role key. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
